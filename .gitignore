# ==========================================
# 敏感内容 - 不上传到GitHub
# ==========================================

# 音频文件（所有格式）
*.mp3
*.wav
*.flac
*.m4a
*.aac
*.ogg
*.wma

# 图片文件（封面、海报等）
web/assets/audio/**/*.png
web/assets/audio/**/*.jpg
web/assets/audio/**/*.jpeg
web/assets/audio/**/*.gif
web/assets/audio/**/*.webp

# 歌词文件（如果包含敏感信息）
web/assets/audio/**/*.lrc
web/assets/audio/**/*.txt

# Android assets中的web资源（会在构建时自动复制）
android/MusicApp/app/src/main/assets/web/

# ==========================================
# Android构建相关
# ==========================================
android/MusicApp/.gradle/
android/MusicApp/local.properties
android/MusicApp/.idea/
android/MusicApp/build/
android/MusicApp/app/build/
android/MusicApp/captures/
android/MusicApp/*.iml
android/MusicApp/.DS_Store

# ==========================================
# 开发工具
# ==========================================

# Gradle
.gradle/
gradle-app.setting

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# 系统文件
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# 日志和临时文件
# ==========================================
*.log
npm-debug.log*
*.tmp
*.temp

# ==========================================
# 其他敏感文件（根据需要添加）
# ==========================================
# 如果有配置文件包含密钥、密码等
# config/secrets.js
# .env